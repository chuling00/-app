<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#000000">

    <!-- 预览区域 -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <!-- 在 PreviewView 后面添加洋葱皮图层 -->
    <ImageView
        android:id="@+id/onionSkinView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"/>

    <!-- 左侧工具栏 -->
    <LinearLayout
        android:layout_width="80dp"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:background="#80000000"
        android:padding="8dp">

        <!-- 返回按钮 -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_back"
            android:layout_marginTop="20dp"/>

        <!-- 撤销按钮 -->
        <TextView
            android:id="@+id/btnUndo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="撤回"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:padding="8dp"
            android:layout_marginTop="20dp"/>

        <!-- 竖直滑块 -->
        <SeekBar
            android:id="@+id/seekBarIndicator"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:rotation="270"
            android:layout_marginTop="50dp"
            android:layout_marginBottom="32dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/seekbar_progress"
            android:thumb="@drawable/seekbar_thumb"
            android:splitTrack="false"
            android:translationX="-40dp"/>

        <!-- 更多按钮 -->
        <TextView
            android:id="@+id/btnMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="30dp"
            android:text="..."
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:gravity="center"
            android:padding="8dp"/>

        <!-- 切换摄像头按钮 -->
        <ImageButton
            android:id="@+id/btnSwitchCamera"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_switch_camera"
            android:padding="2dp"
            android:layout_marginTop="32dp"/>
    </LinearLayout>

    <!-- 右侧工具栏 -->
    <LinearLayout
        android:layout_width="80dp"
        android:layout_height="500dp"
        android:layout_alignParentEnd="true"
        android:orientation="vertical"
        android:padding="8dp"
        android:gravity="center"
        android:background="#80000000">

        <!-- 完成按钮 -->
        <TextView
            android:id="@+id/btnDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="完成"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:padding="8dp"/>

        <!-- 连拍按钮 -->
        <TextView
            android:id="@+id/btnBurst"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:text="连拍 1"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:padding="8dp"/>

        <!-- 拍摄按钮 -->
        <TextView
            android:id="@+id/btnCapture"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:text="拍摄"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:padding="16dp"
            android:background="@color/custom_user_icon_color"/>

        <!-- 延时按钮 -->
        <TextView
            android:id="@+id/btnTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:text="延时"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:padding="8dp"/>

        <!-- 预览区域 - 恢复点击功能 -->
        <FrameLayout
            android:id="@+id/previewContainer"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:background="@color/black"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="预览图片" />

        </FrameLayout>

    </LinearLayout>

    <!-- 在最后添加闪光层 -->
    <View
        android:id="@+id/flashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:visibility="gone"/>

    <!-- 在更多工具框中添加按钮 -->
    <LinearLayout
        android:id="@+id/moreToolbar"
        android:layout_width="80dp"
        android:layout_height="500dp"
        android:layout_marginStart="80dp"
        android:orientation="vertical"
        android:background="#80000000"
        android:padding="8dp"
        android:gravity="center_horizontal"
        android:visibility="gone"
        android:alpha="0">

        <!-- 闪光灯按钮 -->
        <ImageButton
            android:id="@+id/btnFlash"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="20dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_flash_off"
            android:scaleType="fitCenter"/>

        <!-- 参考线按钮 -->
        <ImageButton
            android:id="@+id/btnGrid"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="20dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_grid"
            android:scaleType="fitCenter"/>

    </LinearLayout>

    <!-- 修改参考线视图 -->
    <com.example.myapplication.GridOverlayView
        android:id="@+id/gridView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"/>
</RelativeLayout>
