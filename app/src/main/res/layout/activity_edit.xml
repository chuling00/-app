<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- 左侧工具栏 -->
    <LinearLayout
        android:id="@+id/leftToolbar"
        android:layout_width="50dp"
        android:layout_height="match_parent"
        android:background="#0D0E31"
        android:orientation="vertical"
        android:padding="8dp"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_back"
            android:scaleType="fitCenter"/>
    </LinearLayout>

    <!-- 右侧工具栏 -->
    <LinearLayout
        android:id="@+id/rightToolbar"
        android:layout_width="50dp"
        android:layout_height="match_parent"
        android:background="#0D0E31"
        android:orientation="vertical"
        android:padding="8dp"
        android:gravity="center_horizontal"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnDone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_done"
            android:scaleType="fitCenter"/>

        <ImageButton
            android:id="@+id/btnCapture"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="24dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_capture"
            android:scaleType="fitCenter"/>

        <ImageButton
            android:id="@+id/btnFrameRate"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="24dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_frame_rate"
            android:scaleType="fitCenter"/>

        <ImageButton
            android:id="@+id/btnPlay"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="24dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_play"
            android:scaleType="fitCenter"/>

        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@null"
            android:src="@drawable/ic_delete"
            android:layout_marginTop="8dp"/>

        <ImageButton
            android:id="@+id/btnExport"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_export"
            android:layout_below="@id/btnDelete"
            android:layout_marginTop="16dp"/>
    </LinearLayout>

    <!-- 主预览区域 -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toEndOf="@id/leftToolbar"
        app:layout_constraintEnd_toStartOf="@id/rightToolbar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/photoListLayout">

        <ImageView
            android:id="@+id/mainImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"/>

        <ImageView
            android:id="@+id/bufferImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:visibility="invisible"/>

    </FrameLayout>

    <!-- 底部预览区域 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/photoListLayout"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:clipToPadding="false"
        android:orientation="horizontal"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/leftToolbar"
        app:layout_constraintEnd_toStartOf="@id/rightToolbar"/>

</androidx.constraintlayout.widget.ConstraintLayout>
